{
  "name": "opengraph-lite-viewer-publication-carousel-tools",
  "version": "2.0.0-rc.45",
  "private": true,
  "description": "Pinned local tooling for rebuilding the OpenGraph publication carousel.",
  "scripts": {
    "carousel:check-tools": "node tools/check_publication_carousel_tooling.js",
    "carousel:export": "node tools/export_publication_carousel.js",
    "carousel:check": "python tools/check_publication_carousel.py",
    "carousel:build": "python tools/build_publication_carousel_zip.py",
    "utterances:check": "node tools/check_utterances.js",
    "utterances:views": "node tools/check_utterance_kernel_views.js",
    "utterances:recursive": "node tools/check_recursive_kernel_builder.js"
  },
  "devDependencies": {
    "playwright": "1.61.1"
  },
  "engines": {
    "node": ">=18"
  }
}
