{
  "name": "OpenGraph Lite Viewer",
  "short_name": "OpenGraph Lite",
  "description": "OpenGraph Lite Viewer for JaN/Open Notation with Dutch example sentences, Dutch word order, named projections, views and LEX placement rules.",
  "start_url": "./index.html?ogv=v2.0.5",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f8fafc",
  "theme_color": "#0f172a",
  "icons": [
    {
      "src": "icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
