{
  "schema": "opengraph-project-config",
  "version": "v2.0.0-rc.45",
  "kind": "default",
  "enabled": true,
  "description": "Bundled OGN Base defaults. Keep this file; config/user-config.json overlays it.",
  "config": {
    "version": "v2.0.0-rc.45",
    "profile": "base",
    "preconfig": {
      "insertion": {
        "lex": false,
        "synt": false,
        "log": false
      }
    },
    "features": {
      "adverbs": false
    },
    "centerMode": "syntax",
    "projection": "axes",
    "sourceAxes": [
      "lex",
      "synt",
      "log"
    ],
    "treeChoice": "auto-min",
    "functionalOrder": "left-first",
    "branchOrder": "normal",
    "layoutDensity": "max",
    "viewFitMode": "max",
    "helpLayoutMode": "auto",
    "readmeTopicEdits": {},
    "readmeCarousels": {},
    "showGrid": true,
    "showRelations": true,
    "showLabels": true,
    "placementMode": "language-tree",
    "directPlacementGeneral": {
      "targetCount": 31,
      "intervalMs": 650,
      "showPath": true,
      "showNumbers": true,
      "showMetrics": true,
      "nodeSize": "normal",
      "gridMargin": "normal"
    },
    "greedyGrowConfig": {
      "strategy": "compact-four-arm",
      "orientation": "original"
    },
    "randomPlacementConfig": {
