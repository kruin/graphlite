    "lexProjectionColor": "blue",
    "syntProjectionColor": "green",
    "logProjectionColor": "purple",
    "gridColor": "soft-slate",
    "gridLineWeight": "normal",
    "gridSizeHorizontal": "100",
    "gridSizeVertical": "100",
    "treeLineColor": "blue",
    "treeLineWeight": "strong",
    "kernelBranchHorizontal": "compact",
    "kernelBranchVertical": "compact",
  "kernelBranchFlip": "auto",
  "multiOgnFlipHold": "pause",
    "anaphorFlipVariants": {},
    "causalAnaphorVariant": "die",
    "projectionLineWeight": "normal",
    "boxLineWeight": "normal",
    "projectionBoxDraggable": true,
    "projectionBoxManual": null,
    "southBoxDraggable": true,
    "southBoxManual": null,
    "freeSlotCount": 2,
    "topMenusAbove": []
