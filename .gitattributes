# Keep line endings stable across Windows, GitHub Pages and zip builds.
# Git stores text canonically; the working tree receives the explicit format
# below, independent of a user's global core.autocrlf setting.
* text=auto

.gitattributes text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.nojekyll text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.webmanifest text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.graph text eol=lf
*.opn text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
